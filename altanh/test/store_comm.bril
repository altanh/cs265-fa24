@store_comm {
    zero: int = const 0;
    one: int = const 1;
    two: int = const 2;
    p: ptr<int> = alloc one;
    q: ptr<int> = alloc one;
    # q: ptr<int> = ptradd p zero;
    store p one;
    store q two;
    just_one: int = load p;
    store p one;
    just_two: int = load q;
    print just_one;
    print just_two;
}
